---
// Dark poster card (Vid01): title top-left, stripe art in the middle, caption bottom-left,
// and a real QR code to the same page bottom-right.
import StripeArt from './StripeArt.astro';
import { qrSvg } from '../lib/qr';

interface Props {
  href: string;
  title: string;
  caption: string;
  shape: 'sphere' | 'crescent' | 'wave' | 'pulse';
  parallax?: number;
}
const { href, title, caption, shape, parallax = 0 } = Astro.props;
const qr = await qrSvg(new URL(href, Astro.site).toString());
---
<div class="poster-slot">
  <a class="poster" href={href} data-parallax={parallax || undefined}>
    <span class="poster__title label label--ink" data-decode>{title}</span>
    <div class="poster__art"><StripeArt shape={shape} /></div>
    <span class="poster__caption label">{caption}</span>
    <span class="poster__qr" set:html={qr} />
    <span class="poster__go label label--ink">Open <span class="arrow">↗</span></span>
  </a>
</div>

<style>
  .poster-slot { position: relative; }
  .poster {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    aspect-ratio: 2 / 3;
    padding: 1.1rem;
    background: radial-gradient(120% 80% at 50% 0%, #1e1f24 0%, var(--bg-poster) 55%, #111215 100%);
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
    will-change: transform;
    transition: border-color var(--dur) var(--ease-out);
  }
  .poster:hover, .poster:focus-visible { border-color: var(--line-strong); }
  .poster__art { min-height: 0; margin: 0.5rem -1.1rem; }
  .poster__caption { align-self: end; max-width: 60%; }
  .poster__qr {
    position: absolute;
    right: 1.1rem;
    bottom: 1.1rem;
    width: 44px;
    height: 44px;
    opacity: 0.85;
    transition: opacity var(--dur) var(--ease-out);
  }
  .poster__qr :global(svg) { width: 100%; height: 100%; }
  .poster__go {
    position: absolute;
    right: 1.1rem;
    top: 1.1rem;
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
  }
  .poster:hover .poster__go, .poster:focus-visible .poster__go { opacity: 1; }
  /* One column on phones: landscape posters so each one isn't a full screen tall. */
  @media (max-width: 719px) {
    .poster { aspect-ratio: 4 / 3; }
  }
</style>
