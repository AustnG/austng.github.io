---
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import GalleryPanel from '../components/GalleryPanel.astro';
import HalftoneMark from '../components/HalftoneMark.astro';
import Poster from '../components/Poster.astro';
import { getProfile, getExperience } from '../lib/content';

const p = await getProfile();
const experience = await getExperience();
const current = experience.find((e) => !e.end);
const keyProjects = experience.flatMap((e) => e.projects.map((pr) => ({ ...pr, company: e.company })));
const year = new Date().getFullYear();
---
<Base title={`${p.name}, ${p.headline}`}>
  <section class="hero wrap">
    <div class="hero__meta">
      <span class="label" data-decode>Resume / Portfolio / {year}</span>
      <span class="label hero__now">
        <span class="dot" aria-hidden="true"></span>
        Now at <span class="label--ink">{p.company}</span>
      </span>
    </div>

    <Wordmark lines={['AUSTIN', 'GREER']} label={p.name} />

    <div class="hero__foot">
      <p class="hero__lede">
        {p.headline}. {p.intro}
      </p>
      <div class="hero__cta">
        <a class="btn btn--solid" href="/resume">Resume</a>
        <a class="btn" href={p.links.linkedin} rel="me noopener" target="_blank">LinkedIn <span class="arrow">↗</span></a>
      </div>
    </div>
  </section>

  <section class="wrap mark-section" data-reveal>
    <GalleryPanel tl="AG / selected" tr="Platform · Music · Sport" bl={String(year)} br={p.tagline} tall>
      <div class="mark-wrap">
        <HalftoneMark glyphs={['AG', 'code', 'note', 'ball']} label="Austin Greer monogram" grid={58} />
      </div>
    </GalleryPanel>
  </section>

  <section class="section wrap now">
    <div class="section-head">
      <h2 data-reveal>Now</h2>
      <span class="label" data-decode>01 / Career</span>
    </div>
    <div class="now__grid">
      <div class="now__role" data-reveal>
        <p class="label">Current role</p>
        <p class="now__title">{current?.title ?? p.role}</p>
        <p class="now__company">{p.company}</p>
      </div>
      <div class="now__body" data-reveal>
        <p class="now__summary">{p.summary}</p>
        <dl class="stats">
          {p.stats.map((s) => <div><dt class="label">{s.label}</dt><dd>{s.value}</dd></div>)}
        </dl>
      </div>
    </div>
  </section>

  <section class="section wrap index-section">
    <div class="section-head">
      <h2 data-reveal>Selected work</h2>
      <a class="label link" href="/resume" data-decode>Full resume →</a>
    </div>
    <ol class="index">
      {keyProjects.map((pr) => (
        <li class="index__row" data-reveal data-decode-host>
          <span class="label index__year">{pr.year}</span>
          <span class="index__name" data-decode>{pr.name}</span>
          <span class="index__desc">{pr.desc}</span>
          <span class="label index__co">{pr.company}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2 data-reveal>Off the clock</h2>
      <span class="label" data-decode>02 / Everything else</span>
    </div>
    <div class="posters">
      <Poster href="/portfolio" title="Portfolio" caption="Sites, apps, and experiments" shape="wave" />
      <Poster href="/music" title="Music" caption="Bands, recordings, and shows" shape="pulse" />
      <Poster href="/sport" title="Sport" caption="Toasty FC · BG Futsal" shape="sphere" />
    </div>
  </section>
</Base>

<style>
  .hero {
    min-height: calc(100svh - 4rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
    padding-top: 1.5rem;
    padding-bottom: 2.5rem;
    position: relative;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 10% 0 auto 30%;
    height: 70%;
    background: radial-gradient(closest-side, rgb(255 255 255 / 0.05), transparent);
    pointer-events: none;
    z-index: -1;
  }
  .hero__meta { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .hero__now { display: inline-flex; align-items: center; gap: 0.5rem; }
  .dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--spec-3);
    box-shadow: 0 0 0 0 var(--spec-3);
    animation: ping 2.4s var(--ease-out) infinite;
  }
  @keyframes ping { 0% { box-shadow: 0 0 0 0 rgb(142 238 230 / 0.6); } 80%, 100% { box-shadow: 0 0 0 9px rgb(142 238 230 / 0); } }
  .hero__foot {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .hero__lede { max-width: 34ch; font-size: var(--step-1); color: var(--ink-soft); line-height: 1.45; }
  .hero__cta { display: flex; gap: 0.6rem; flex-wrap: wrap; }

  .mark-wrap { width: min(62vw, 420px); }

  .now__grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: clamp(2rem, 1rem + 4vw, 6rem); }
  .now__title { font-size: var(--step-3); line-height: 1.05; letter-spacing: -0.03em; margin-top: 0.8rem; }
  .now__company { font-size: var(--step-1); color: var(--ink-muted); margin-top: 0.6rem; }
  .now__summary { font-size: var(--step-1); line-height: 1.55; color: var(--ink-soft); max-width: var(--measure); }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin: 2.5rem 0 0; }
  .stats div { border-top: 1px solid var(--line); padding-top: 0.9rem; }
  .stats dd { margin: 0.4rem 0 0; font-size: var(--step-3); letter-spacing: -0.03em; line-height: 1; }

  .index { list-style: none; margin: 0; padding: 0; }
  .index__row {
    display: grid;
    grid-template-columns: 5rem 1fr 1.6fr auto;
    gap: 1.25rem;
    align-items: baseline;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--line);
    transition: background var(--dur) var(--ease-out), padding var(--dur) var(--ease-out);
  }
  .index__row:hover { background: rgb(255 255 255 / 0.025); padding-inline: 0.75rem; }
  .index__name { font-size: var(--step-1); letter-spacing: -0.01em; }
  .index__desc { color: var(--ink-muted); font-size: var(--step--1); line-height: 1.5; }
  .index__co { text-align: right; }

  /* Three equal posters in one row; a single column on phones (see Poster.astro for the shape change). */
  .posters { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 0.5rem + 2vw, 2rem); align-items: stretch; }

  @media (max-width: 900px) {
    .now__grid { grid-template-columns: 1fr; }
    .index__row { grid-template-columns: 3.5rem 1fr; }
    .index__desc { grid-column: 2; }
    .index__co { grid-column: 2; text-align: left; }
  }
  @media (max-width: 719px) {
    .posters { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .hero { min-height: auto; gap: 2rem; padding-top: 0.5rem; }
    .stats { grid-template-columns: 1fr 1fr 1fr; }
    .stats dd { font-size: var(--step-2); }
  }
</style>
