---
import Base from '../layouts/Base.astro';
import HalftoneMark from '../components/HalftoneMark.astro';
import { getPublicProjects } from '../lib/content';

const visible = await getPublicProjects();

const sections = [
  {
    id: 'shipped',
    title: 'Shipped',
    note: 'Live builds from work, teams, and leagues',
    items: visible.filter((p) => p.status === 'live'),
  },
  {
    id: 'active',
    title: 'In progress',
    note: 'Active builds and what is coming next',
    items: visible.filter((p) => p.status === 'in-progress' || p.status === 'next'),
  },
  {
    id: 'play',
    title: 'Play & ideas',
    note: 'Experiments, prototypes, and shareable play ideas',
    items: visible.filter((p) => p.status === 'idea'),
  },
  {
    id: 'archive',
    title: 'Paused & archived',
    note: 'On-hold and earlier experiments',
    items: visible.filter((p) => p.status === 'paused' || p.status === 'archived'),
  },
].filter((section) => section.items.length > 0);

const statusLabel = {
  live: 'Live',
  'in-progress': 'In progress',
  next: 'Up next',
  idea: 'Idea',
  paused: 'Paused',
  archived: 'Archived',
} as const;
---
<Base
  title="Portfolio, Austin Greer"
  current="portfolio"
  description="Shipped work, active builds, and shareable experiments by Austin Greer: Salesforce builds, integrations, league and team websites, and prototypes."
>
  <section class="wrap page-head">
    <p class="label" data-decode>02 / Portfolio</p>
    <h1>Things I've built</h1>
    <p class="intro">
      Shipped work from Salesforce and integrations, active builds in motion, and a few play ideas worth sharing.
    </p>
    {sections.length > 1 && (
      <nav class="jump" aria-label="Portfolio sections">
        {sections.map((s) => (
          <a class="jump__item label" href={`#${s.id}`}>
            <span class="label--ink">{s.title}</span>
            <span class="jump__count">{String(s.items.length).padStart(2, '0')}</span>
          </a>
        ))}
      </nav>
    )}
  </section>

  {sections.map((g) => (
    <section class="wrap group" id={g.id}>
      <div class="section-head">
        <h2>{g.title}</h2>
        <span class="label">{g.note}</span>
      </div>
      <ul class="grid">
        {g.items.map((p) => (
          <li class="card" data-reveal data-halftone-host>
            <div class="card__plate">
              <span class="card__corner card__tl">
                {p.mark.length <= 3 && p.mark === p.mark.toUpperCase() ? p.mark : p.name}
              </span>
              <span class="card__corner card__tr">{p.year}</span>
              <span class="card__corner card__bl">{p.category}</span>
              <span class:list={['card__corner card__br', `status--${p.status}`]}>
                {statusLabel[p.status]}
              </span>
              <div class="card__mark">
                <HalftoneMark glyphs={[p.mark]} mode="hover" grid={40} label={`${p.name} mark`} />
              </div>
            </div>
            <div class="card__body">
              <h3>{p.name}</h3>
              <p>{p.desc}</p>
              {p.platform.length > 0 && (
                <p class="label card__stack">{p.platform.join(' · ')}</p>
              )}
              {p.link && (
                <a class="label label--ink link card__link" href={p.link} target="_blank" rel="noopener">
                  {p.linkText ?? 'Visit'} <span class="arrow">↗</span>
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>

<style>
  .page-head { padding-top: clamp(2rem, 1rem + 5vw, 6rem); padding-bottom: clamp(2.5rem, 2rem + 3vw, 5rem); }
  h1 { font-size: var(--step-4); letter-spacing: -0.045em; margin-top: 1rem; max-width: 14ch; }
  .intro { margin-top: 1.25rem; font-size: var(--step-1); color: var(--ink-soft); max-width: 52ch; }

  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 2rem;
  }
  .jump__item {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    transition: border-color var(--dur) var(--ease-out), background var(--dur) var(--ease-out);
  }
  .jump__item:hover {
    border-color: var(--line-strong);
    background: var(--bg-raised);
  }
  .jump__count { color: var(--ink-faint); }

  .group { padding-bottom: clamp(3rem, 2rem + 4vw, 6rem); scroll-margin-top: 5rem; }
  .section-head h2 { font-size: var(--step-2); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: clamp(1rem, 0.5rem + 1.5vw, 1.75rem);
  }
  .card { display: flex; flex-direction: column; }
  .card__plate {
    position: relative;
    background: var(--gallery);
    color: var(--gallery-ink);
    border-radius: 4px;
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
  }
  .card__mark { width: 46%; }
  .card__corner {
    position: absolute;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gallery-muted);
  }
  .card__tl { top: 0.8rem; left: 0.9rem; color: var(--gallery-ink); }
  .card__tr { top: 0.8rem; right: 0.9rem; }
  .card__bl { bottom: 0.8rem; left: 0.9rem; }
  .card__br { bottom: 0.8rem; right: 0.9rem; }
  .status--live { background: var(--gallery-ink); color: var(--gallery); padding: 0 0.35em; }
  .status--in-progress { border: 1px solid var(--gallery-ink); color: var(--gallery-ink); padding: 0 0.35em; }
  .card__body { padding: 1.1rem 0.1rem 0; display: grid; gap: 0.55rem; }
  .card__body h3 { font-size: var(--step-1); letter-spacing: -0.015em; }
  .card__body p { color: var(--ink-muted); font-size: var(--step--1); line-height: 1.55; }
  .card__body .card__stack { color: var(--ink-faint); font-size: var(--step--2); margin-top: 0.1rem; }
  .card__link { justify-self: start; margin-top: 0.2rem; }
</style>
